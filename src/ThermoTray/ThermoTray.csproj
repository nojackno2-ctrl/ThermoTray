<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ThermoTray.ico</ApplicationIcon>
    <AssemblyName>ThermoTray</AssemblyName>
    <RootNamespace>ThermoTray</RootNamespace>
    <!--
      A tray app allocates almost nothing between samples. Workstation non-concurrent GC drops the
      background GC thread and the heap it keeps reserved for collections this process never needs.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Precompiled code removes most of the JIT work, and its memory, from startup. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Also embedded as a resource so Window.Icon can load it at runtime. -->
    <Resource Include="ThermoTray.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ThermoTray.Tests" />
  </ItemGroup>
</Project>
