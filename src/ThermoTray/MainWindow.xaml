<Window x:Class="ThermoTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ThermoTray" Height="470" Width="500" MinHeight="430" MinWidth="450"
        Background="{StaticResource PanelBrush}" Foreground="White"
        Icon="ThermoTray.ico"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="ThermoTray" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="{Binding T[Subtitle]}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
    </StackPanel>

    <!-- UniformGrid ignores collapsed children, so the CPU card fills the row on a machine with no readable GPU. -->
    <primitives:UniformGrid Grid.Row="1" Rows="1" Margin="0,26,0,20">
      <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,9,0">
        <StackPanel>
          <TextBlock Text="{Binding T[CpuUsage]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
          <TextBlock Text="{Binding CpuUsage}" Foreground="{StaticResource ControlTextBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,8" />
          <TextBlock Text="{Binding T[CpuTemperature]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
          <TextBlock Text="{Binding CpuTemperature}" Foreground="{StaticResource AccentBrush}" FontSize="38" FontWeight="SemiBold" Margin="0,5,0,4" />
          <TextBlock Text="{Binding CpuSource}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="9,0,0,0"
              Visibility="{Binding IsGpuPresent, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel>
          <TextBlock Text="{Binding T[GpuUsage]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
          <TextBlock Text="{Binding GpuUsage}" Foreground="{StaticResource ControlTextBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,8" />
          <TextBlock Text="{Binding T[GpuTemperature]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
          <TextBlock Text="{Binding GpuTemperature}" Foreground="{StaticResource GpuAccentBrush}" FontSize="38" FontWeight="SemiBold" Margin="0,5,0,4" />
          <TextBlock Text="{Binding GpuSource}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </primitives:UniformGrid>

    <StackPanel Grid.Row="2">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <TextBlock Margin="0,0,0,12"
                 Visibility="{Binding IsDriverActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Hyperlink NavigateUri="{Binding DriverDownloadUrl}" RequestNavigate="OnDriverLinkRequestNavigate"
                   Foreground="{StaticResource AccentBrush}">
          <TextBlock Text="{Binding T[DriverDownload]}" />
        </Hyperlink>
      </TextBlock>
      <WrapPanel>
        <CheckBox Content="{Binding T[StartWithWindows]}" IsChecked="{Binding StartWithWindows}" Margin="0,0,20,8" />
        <CheckBox Content="{Binding T[HideWhenClosed]}" IsChecked="{Binding HideWhenClosed}" Margin="0,0,20,8" />
        <TextBlock Text="{Binding T[Language]}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox Width="135" SelectedValuePath="Tag" SelectedValue="{Binding Language}" Margin="0,0,0,8">
          <ComboBoxItem Tag="zh-TW">繁體中文</ComboBoxItem>
          <ComboBoxItem Tag="en-US">English</ComboBoxItem>
        </ComboBox>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
