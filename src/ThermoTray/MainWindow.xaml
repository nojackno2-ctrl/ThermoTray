<Window x:Class="ThermoTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ThermoTray" Width="540" MinWidth="460"
        Background="{StaticResource PanelBrush}" Foreground="White"
        Icon="ThermoTray.ico"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">
  <!--
    The height follows the content rather than a fixed number. A card is a rounded Border, which clips
    whatever does not fit inside it, so any window height guessed here would silently cut the last line
    off the cards on the first system font, display scale, or translation that needed a little more room.
  -->
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <!-- The version sits on the title's baseline so it reads as part of the name rather than as data. -->
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="ThermoTray" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" FontSize="14"
                   VerticalAlignment="Bottom" Margin="9,0,0,5" />
      </StackPanel>
      <TextBlock Text="{Binding T[Subtitle]}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
    </StackPanel>

    <!-- UniformGrid ignores the collapsed GPU collection, so the CPU card fills the row on a machine with no readable GPU. -->
    <primitives:UniformGrid Grid.Row="1" Rows="1" Margin="0,26,0,20">
      <Border x:Name="CpuCard" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,9,0">
        <StackPanel>
          <TextBlock Text="{Binding CpuDeviceName}" Foreground="{StaticResource AccentBrush}"
                     FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding T[CpuUsage]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
            <CheckBox Grid.Column="1" Content="{Binding T[ShowInTray]}"
                      IsChecked="{Binding ShowCpuUsageInTray, Mode=TwoWay}"
                      FontSize="11" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding CpuUsage}" Foreground="{StaticResource ControlTextBrush}" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding T[CpuTemperature]}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
            <CheckBox Grid.Column="1" Content="{Binding T[ShowInTray]}"
                      IsChecked="{Binding ShowCpuTemperatureInTray, Mode=TwoWay}"
                      FontSize="11" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding CpuTemperature}" Foreground="{StaticResource AccentBrush}" FontSize="38" FontWeight="SemiBold" Margin="0,5,0,4" />
          <TextBlock Text="{Binding CpuSource}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ItemsControl x:Name="GpuCards"
                    ItemsSource="{Binding Gpus}"
                    Margin="9,0,0,0"
                    Visibility="{Binding IsGpuPresent, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{Binding DeviceName}" Foreground="{StaticResource GpuAccentBrush}"
                           FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource MutedBrush}"
                           FontSize="13" Margin="0,2,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding UsageLabel}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                  <CheckBox Grid.Column="1" Content="{Binding DataContext.T[ShowInTray], RelativeSource={RelativeSource AncestorType=Window}}"
                            IsChecked="{Binding ShowUsageInTray, Mode=TwoWay}"
                            FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding Usage}" Foreground="{StaticResource ControlTextBrush}"
                           FontSize="27" FontWeight="SemiBold" Margin="0,5,0,8" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TemperatureLabel}" Foreground="{StaticResource MutedBrush}" FontSize="15" />
                  <CheckBox Grid.Column="1" Content="{Binding DataContext.T[ShowInTray], RelativeSource={RelativeSource AncestorType=Window}}"
                            IsChecked="{Binding ShowTemperatureInTray, Mode=TwoWay}"
                            FontSize="11" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock Text="{Binding Temperature}" Foreground="{StaticResource GpuAccentBrush}"
                           FontSize="38" FontWeight="SemiBold" Margin="0,5,0,4" />
                <TextBlock Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </primitives:UniformGrid>

    <StackPanel Grid.Row="2">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <TextBlock Margin="0,0,0,12"
                 Visibility="{Binding IsDriverActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Hyperlink NavigateUri="{Binding DriverDownloadUrl}" RequestNavigate="OnDriverLinkRequestNavigate"
                   Foreground="{StaticResource AccentBrush}">
          <TextBlock Text="{Binding T[DriverDownload]}" />
        </Hyperlink>
      </TextBlock>
      <WrapPanel>
        <CheckBox Content="{Binding T[StartWithWindows]}" IsChecked="{Binding StartWithWindows}" Margin="0,0,20,8" />
        <CheckBox Content="{Binding T[HideWhenClosed]}" IsChecked="{Binding HideWhenClosed}" Margin="0,0,20,8" />
        <TextBlock Text="{Binding T[Language]}" VerticalAlignment="Center" Margin="0,0,8,8" />
        <ComboBox Width="135" SelectedValuePath="Tag" SelectedValue="{Binding Language}" Margin="0,0,0,8">
          <ComboBoxItem Tag="zh-TW">繁體中文</ComboBoxItem>
          <ComboBoxItem Tag="en-US">English</ComboBoxItem>
        </ComboBox>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>
