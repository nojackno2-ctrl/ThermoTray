<Window x:Class="ThermoTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ThermoTray"
        Width="720"
        MinWidth="600"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        SizeToContent="Height"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        Icon="ThermoTray.ico"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyboardNavigation.TabNavigation="Cycle">
  <Grid x:Name="RootLayout" Background="{DynamicResource WindowBrush}" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
      <StackPanel Grid.Column="1" Margin="14,0,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="ThermoTray" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="ProductVersionText"
                     Text="{Binding Version}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalAlignment="Bottom"
                     Margin="10,0,0,4" />
        </StackPanel>
        <TextBlock Text="{Binding T[Subtitle]}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Height="1"
            Margin="0,18,0,0"
            Background="{DynamicResource BorderBrush}" />

    <ScrollViewer Grid.Row="2"
                  MaxHeight="560"
                  Margin="0,18,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel>
        <Border x:Name="CpuCard" Style="{StaticResource DevicePanelStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="CPU"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Margin="0,0,14,0" />
              <TextBlock x:Name="CpuDeviceNameText"
                         Grid.Column="1"
                         Text="{Binding CpuDeviceName}"
                         FontSize="17"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource MetricPanelStyle}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding T[CpuUsage]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="CpuUsageTrayToggle"
                              Content="{Binding T[ShowInTray]}"
                              IsChecked="{Binding ShowCpuUsageInTray, Mode=TwoWay}"
                              Style="{StaticResource MetricToggleStyle}" />
                  </Grid>
                  <TextBlock Text="{Binding CpuUsage}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontFamily="Consolas"
                             FontSize="32"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="{Binding T[CpuUsage]}" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource MetricPanelStyle}">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding T[CpuTemperature]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="CpuTemperatureTrayToggle"
                              Content="{Binding T[ShowInTray]}"
                              IsChecked="{Binding ShowCpuTemperatureInTray, Mode=TwoWay}"
                              Style="{StaticResource MetricToggleStyle}" />
                  </Grid>
                  <TextBlock Text="{Binding CpuTemperature}"
                             Foreground="{DynamicResource AccentBrush}"
                             FontFamily="Consolas"
                             FontSize="32"
                             FontWeight="SemiBold"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="{Binding T[CpuTemperature]}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
              <TextBlock Text="{Binding CpuSource}"
                         Foreground="{DynamicResource TextMutedBrush}"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap" />
            </Border>
          </Grid>
        </Border>

        <ItemsControl x:Name="GpuCards"
                      ItemsSource="{Binding Gpus}"
                      Margin="0,12,0,0"
                      Visibility="{Binding IsGpuPresent, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,12" Style="{StaticResource DevicePanelStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DeviceName}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                  </Grid>

                  <Grid Grid.Row="1" Margin="0,16,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource MetricPanelStyle}">
                      <StackPanel>
                        <Grid>
                          <TextBlock Text="{Binding UsageLabel}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     VerticalAlignment="Center" />
                          <CheckBox Content="{Binding DataContext.T[ShowInTray], RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsChecked="{Binding ShowUsageInTray, Mode=TwoWay}"
                                    Style="{StaticResource MetricToggleStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding Usage}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontFamily="Consolas"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="{Binding UsageLabel}" />
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricPanelStyle}">
                      <StackPanel>
                        <Grid>
                          <TextBlock Text="{Binding TemperatureLabel}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     VerticalAlignment="Center" />
                          <CheckBox Content="{Binding DataContext.T[ShowInTray], RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsChecked="{Binding ShowTemperatureInTray, Mode=TwoWay}"
                                    Style="{StaticResource MetricToggleStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding Temperature}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Consolas"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   AutomationProperties.Name="{Binding TemperatureLabel}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <TextBlock Text="{Binding Source}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="StatusPanel"
            Grid.Row="3"
            Margin="0,14,0,0"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"
            AutomationProperties.LiveSetting="Polite">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AccentBrush}" CornerRadius="11,0,0,11" />
        <StackPanel Grid.Column="1" Margin="14,12">
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0"
                     Visibility="{Binding IsDriverActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Hyperlink NavigateUri="{Binding DriverDownloadUrl}"
                       RequestNavigate="OnDriverLinkRequestNavigate">
              <TextBlock Text="{Binding T[DriverDownload]}" FontWeight="SemiBold" />
            </Hyperlink>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="4"
            Height="1"
            Margin="0,18,0,0"
            Background="{DynamicResource BorderBrush}" />

    <WrapPanel x:Name="SettingsPanel" Grid.Row="5" Margin="0,14,0,0" VerticalAlignment="Center">
      <CheckBox Content="{Binding T[StartWithWindows]}"
                IsChecked="{Binding StartWithWindows}"
                Margin="0,0,22,0" />
      <CheckBox Content="{Binding T[HideWhenClosed]}"
                IsChecked="{Binding HideWhenClosed}"
                Margin="0,0,22,0" />
      <TextBlock Text="{Binding T[Language]}"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0" />
      <ComboBox Width="145"
                SelectedValuePath="Tag"
                SelectedValue="{Binding Language}"
                AutomationProperties.Name="{Binding T[Language]}">
        <ComboBoxItem Tag="zh-TW">繁體中文</ComboBoxItem>
        <ComboBoxItem Tag="en-US">English</ComboBoxItem>
      </ComboBox>
    </WrapPanel>
  </Grid>
</Window>
