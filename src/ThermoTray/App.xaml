<Application x:Class="ThermoTray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <SolidColorBrush x:Key="PanelBrush" Color="#20242C" />
    <SolidColorBrush x:Key="CardBrush" Color="#2A303B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#55D6BE" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AAB4C3" />
  </Application.Resources>
</Application>
