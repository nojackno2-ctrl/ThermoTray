<Project>
  <!--
    Shared settings for the .NET sensor sidecar. The product version lives in Cargo.toml;
    scripts/package.ps1 passes it to dotnet publish as -p:Version.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
